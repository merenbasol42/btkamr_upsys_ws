<robot xmlns:xacro="http://www.ros.org/wiki/xacro" robot="btkamr">
    
    <material name="red">
        <color rgba="1.0 0.0 0.0 1.0"/>
    </material>

    <material name="green">
        <color rgba="0.0 1.0 0.0 1.0"/>
    </material>

    <material name="blue">
        <color rgba="0.0 0.0 1.0 1.0"/>
    </material>

    <material name="black">
        <color rgba="0.0 0.0 0.0 1.0"/>
    </material>

    <material name="white">
        <color rgba="1.0 1.0 1.0 1.0"/>
    </material>

    <material name="gray">
        <color rgba="0.6 0.6 0.6 1.0"/>
    </material>


    <xacro:macro name="box_inertia" params="mass lenx leny lenz">
        <mass value="${mass}"/>
        <inertia 
            ixx="${mass * (leny*leny + lenz*lenz) / 12.0}"
            iyy="${mass * (lenx*lenx + lenz*lenz) / 12.0}"
            izz="${mass * (lenx*lenx + leny*leny) / 12.0}"
            ixy="0" ixz="0" iyz="0"
        />
    </xacro:macro>

    <xacro:macro name="cylinder_inertia" params="mass radius length">
        <mass value="${mass}"/>
        <inertia 
            ixx="${mass * (3*radius*radius + length*length) / 12.0}"
            iyy="${mass * (3*radius*radius + length*length) / 12.0}"
            izz="${mass * (radius*radius) / 2.0}"
            ixy="0" ixz="0" iyz="0"
        />
    </xacro:macro>

    <xacro:macro name="sphere_inertia" params="mass radius">
        <mass value="${mass}"/>
        <inertia 
            ixx="${2.0 * mass * radius * radius / 5.0}"
            iyy="${2.0 * mass * radius * radius / 5.0}"
            izz="${2.0 * mass * radius * radius / 5.0}"
            ixy="0" ixz="0" iyz="0"
        />
    </xacro:macro>

    <xacro:macro name="create_box_link" params="name oxyz orpy lenx leny lenz mass material">
        <link name="${name}">
            <inertial>
                <origin xyz="${oxyz}" rpy="${orpy}"/>
                <xacro:box_inertia mass="${mass}" lenx="${lenx}" leny="${leny}" lenz="${lenz}"/>
            </inertial>

            <visual>
                <origin xyz="${oxyz}" rpy="${orpy}"/>
                <geometry><box size="${lenx} ${leny} ${lenz}"/></geometry>
                <material name="${material}"/>
            </visual>

            <collision>
                <origin xyz="${oxyz}" rpy="${orpy}"/>
                <geometry><box size="${lenx} ${leny} ${lenz}"/></geometry>
            </collision>
        </link>
    </xacro:macro>

    <xacro:macro name="create_cylinder_link" params="name oxyz orpy radius length mass material">
        <link name="${name}">
            <inertial>
                <origin xyz="${oxyz}" rpy="${orpy}"/>
                <xacro:cylinder_inertia mass="${mass}" radius="${radius}" length="${length}"/>
            </inertial>

            <visual>
                <origin xyz="${oxyz}" rpy="${orpy}"/>
                <geometry>
                    <cylinder radius="${radius}" length="${length}"/>
                </geometry>
                <material name="${material}"/>
            </visual>

            <collision>
                <origin xyz="${oxyz}" rpy="${orpy}"/>
                <geometry>
                    <cylinder radius="${radius}" length="${length}"/>
                </geometry>
            </collision>
        </link>
    </xacro:macro>

    <xacro:macro name="create_sphere_link" params="name oxyz orpy radius mass material">
        <link name="${name}">
            <inertial>
                <origin xyz="${oxyz}" rpy="${orpy}"/>
                <xacro:sphere_inertia mass="${mass}" radius="${radius}"/>
            </inertial>

            <visual>
                <origin xyz="${oxyz}" rpy="${orpy}"/>
                <geometry>
                    <sphere radius="${radius}"/>
                </geometry>
                <material name="${material}"/>
            </visual>

            <collision>
                <origin xyz="${oxyz}" rpy="${orpy}"/>
                <geometry>
                    <sphere radius="${radius}"/>
                </geometry>
            </collision>
        </link>
    </xacro:macro>


</robot>